# Supabase — copy to .env.local and fill in (.env.local is gitignored).
# Find these in your Supabase project: Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC. Used by server actions /
# route handlers that must bypass RLS (kept out of the browser bundle).
SUPABASE_SERVICE_ROLE_KEY=
